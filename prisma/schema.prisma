generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  THERAPIST
  ADMIN
}

enum TherapistStatus {
  ACTIVE
  INACTIVE
  ONBOARDING
}

enum AvailabilityStatus {
  AVAILABLE
  HELD
  BOOKED
  BLOCKED
}

enum BookingStatus {
  HOLD
  PAYMENT_PENDING
  CONFIRMED
  PAYMENT_FAILED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  EXPIRED
}

model User {
  id         String    @id @default(cuid())
  fullName   String
  email      String?   @unique
  passwordHash String?
  role       UserRole
  therapist  Therapist?
  patientProfile PatientProfile?
  patientBookings Booking[] @relation("PatientBookings")

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model PatientProfile {
  id          String   @id @default(cuid())
  userId       String   @unique
  phoneNumber  String?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Therapist {
  id                 String            @id @default(cuid())
  userId             String            @unique
  slug               String            @unique
  status             TherapistStatus   @default(ACTIVE)
  isVerified         Boolean           @default(false)

  sessionPriceSar    Decimal           @db.Decimal(10, 2)
  rating             Decimal           @default(0) @db.Decimal(3, 2)
  reviewCount        Int               @default(0)
  yearsOfExperience  Int               @default(0)
  profileImageUrl    String?

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile            TherapistProfile?
  specializations    Specialization[]
  availabilities     TherapistAvailability[]
  bookings           Booking[]

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([slug])
  @@index([status])
  @@index([isVerified])
  @@index([rating])
  @@index([sessionPriceSar])
}

model TherapistProfile {
  id               String     @id @default(cuid())
  therapistId      String     @unique

  headlineAr       String?
  bioAr            String
  credentialsAr    String?
  languages        String[]
  sessionModes     String[]

  therapist        Therapist  @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Specialization {
  id               String      @id @default(cuid())
  slug             String      @unique
  nameAr           String
  nameEn           String

  therapists       Therapist[]

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model TherapistAvailability {
  id               String              @id @default(cuid())
  therapistId      String

  startsAtUtc      DateTime
  endsAtUtc        DateTime
  timezone         String              @default("Asia/Riyadh")
  status           AvailabilityStatus  @default(AVAILABLE)

  therapist        Therapist           @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  bookings         Booking[]

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([therapistId, status, startsAtUtc])
  @@index([startsAtUtc])
}

model Booking {
  id                String          @id @default(cuid())
  patientUserId     String
  therapistId       String
  availabilitySlotId String
  status            BookingStatus   @default(HOLD)
  holdExpiresAt     DateTime
  sessionPriceSar   Decimal         @db.Decimal(10, 2)
  confirmedAt       DateTime?
  cancelledAt       DateTime?

  patient           User            @relation("PatientBookings", fields: [patientUserId], references: [id], onDelete: Restrict)
  therapist         Therapist       @relation(fields: [therapistId], references: [id], onDelete: Restrict)
  availabilitySlot  TherapistAvailability @relation(fields: [availabilitySlotId], references: [id], onDelete: Restrict)
  payment           Payment?
  statusHistory     BookingStatusHistory[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([patientUserId, status, createdAt])
  @@index([therapistId, status])
  @@index([availabilitySlotId, status])
  @@index([holdExpiresAt])
}

model BookingStatusHistory {
  id               String        @id @default(cuid())
  bookingId        String
  fromStatus       BookingStatus?
  toStatus         BookingStatus
  note             String?
  actorUserId      String?

  booking          Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([bookingId, createdAt])
}

model Payment {
  id               String        @id @default(cuid())
  bookingId        String        @unique
  status           PaymentStatus @default(INITIATED)
  amountSar        Decimal       @db.Decimal(10, 2)
  provider         String        @default("moyasar")
  providerPaymentId String?      @unique
  providerRawStatus String?
  providerTransactionUrl String?
  providerResponseSnapshot Json?
  verifiedAt       DateTime?
  initiatedAt      DateTime?
  completedAt      DateTime?
  expiresAt        DateTime?
  lastError        String?

  booking          Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  attempts         PaymentAttempt[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([provider, providerRawStatus])
}

model PaymentAttempt {
  id               String        @id @default(cuid())
  paymentId        String
  status           PaymentStatus @default(INITIATED)
  providerRef      String?
  simulatedOutcome String?
  errorMessage     String?

  payment          Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([paymentId, createdAt])
}
